{
  "name": "ecommerce-monorepo",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "db:generate": "pnpm --filter @ecommerce/db generate",
    "db:migrate": "pnpm --filter @ecommerce/db migrate:dev",
    "db:migrate:deploy": "pnpm --filter @ecommerce/db migrate:deploy",
    "db:studio": "pnpm --filter @ecommerce/db studio"
  },
  "devDependencies": {
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.1.0"
}
