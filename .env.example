# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string for Prisma
DATABASE_URL="postgresql://ecom_user:ecom_pass@localhost:5432/ecom_dev?schema=public"

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ─── Auth (NextAuth / JWT) ────────────────────────────────────────────────────
NEXTAUTH_SECRET="change-me-generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# JWT secrets used by the Express API (must differ from each other)
JWT_ACCESS_SECRET="change-me-generate-with-openssl-rand-base64-32"
JWT_REFRESH_SECRET="change-me-generate-with-openssl-rand-base64-32"

# ─── Google OAuth ─────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ─── API ─────────────────────────────────────────────────────────────────────
API_BASE_URL="http://localhost:4000"
# Internal secret used by web → api service calls
API_INTERNAL_SECRET="change-me-generate-with-openssl-rand-hex-32"

# ─── Storage (S3-compatible) ──────────────────────────────────────────────────
S3_BUCKET=""
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_ENDPOINT=""          # leave blank for AWS; set for MinIO / R2

# ─── Stripe ──────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# ─── Email (Resend preferred; falls back to Nodemailer SMTP) ──────────────────
RESEND_API_KEY=""
EMAIL_FROM="noreply@example.com"
# SMTP fallback (used when RESEND_API_KEY is blank)
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""

# ─── App ─────────────────────────────────────────────────────────────────────
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
LOG_LEVEL="info"
